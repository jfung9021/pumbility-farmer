{
  "name": "pumbility-farmer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev",
    "snapshot:local": "python scripts/capture_private_score_snapshot.py",
    "snapshot:phoenix2": "python scripts/capture_private_score_snapshot.py --mix phoenix2",
    "analyze:local": "npm run analyze:phoenix1 && npm run analyze:phoenix2",
    "analyze:phoenix1": "python piu_misgrade_analyzer.py cache --mix phoenix1 --raw-dir .local-data/piu-scores/phoenix1/current --output-dir .local-data/piu-scores/phoenix1/analysis",
    "analyze:phoenix2": "python piu_misgrade_analyzer.py cache --mix phoenix2 --raw-dir .local-data/piu-scores/phoenix2/current --output-dir .local-data/piu-scores/phoenix2/analysis",
    "verify:phoenix1-archive": "python scripts/verify_phoenix1_archive.py",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --test tests/frontend-api.test.ts"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
