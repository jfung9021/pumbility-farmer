# Documentation-only template. Next.js does not automatically load this filename.
# Copy variable names manually into your ignored .env.local or current shell.
# Never put a hosted/production URL or key here.
PUMBILITY_DATABASE_URL=<LOCAL_LOOPBACK_POSTGRES_URL>
# Python/FastAPI persistence selector: vercel (default), shadow, or supabase.
PUMBILITY_DATA_BACKEND=supabase
# Required only when model NPZ binaries are uploaded/read.
PUMBILITY_SUPABASE_URL=http://127.0.0.1:54321
PUMBILITY_SUPABASE_SERVICE_ROLE_KEY=<LOCAL_CLI_SERVICE_ROLE_KEY>
PUMBILITY_STORAGE_BUCKET=pumbility-artifacts
# Use a new local-only value of at least 32 characters; never commit the value.
PUMBILITY_BASELINE_HMAC_KEY=<LOCAL_PRIVATE_HMAC_KEY_AT_LEAST_32_CHARACTERS>
# Leave shadow/canonical runtime writes disabled until local reconciliation passes.
PUMBILITY_SHADOW_STRICT=false
PUMBILITY_CANONICAL_SNAPSHOT_WRITE_ENABLED=false
PIU_LOCAL_ANALYSIS=1
