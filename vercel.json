{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "entrypoint": "pyproject.toml",
      "buildCommand": "python scripts/stage_pumbility_reference_inputs.py",
      "functions": {
        "**/*.py": {
          "maxDuration": 800,
          "excludeFiles": "{piu_live_run/**,piu_phoenix_run/**,synthetic_demo/**,tests/**,__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/phoenix2",
      "schedule": "0 6 * * *"
    }
  ]
}
