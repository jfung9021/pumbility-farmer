{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "**/*.py": {
      "maxDuration": 800,
      "excludeFiles": "{piu_live_run/**,piu_phoenix_run/**,synthetic_demo/**,tests/**,__pycache__/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ]
}
