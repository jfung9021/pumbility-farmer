{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "entrypoint": "pyproject.toml",
      "maxDuration": 800,
      "includeFiles": [
        "public/data/phoenix1.json",
        "public/data/phoenix1.manifest.json",
        "public/data/phoenix1-rerates.json",
        "lib/data/nevsister-chart-videos.json",
        "lib/data/nevsister-chart-video-overrides.json"
      ],
      "excludeFiles": "{piu_live_run/**,piu_phoenix_run/**,synthetic_demo/**,tests/**,__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/phoenix2",
      "schedule": "0 6 * * *"
    }
  ]
}
